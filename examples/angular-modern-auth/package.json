{
  "name": "angular-modern-auth",
  "version": "0.0.0",
  "private": true,
  "description": "BFF + HttpOnly cookie auth companion for omid.dev — Angular interceptor, guards, no JWTs in localStorage",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n bff,ng -c blue,magenta \"npm:bff\" \"npm:serve\"",
    "serve": "ng serve --proxy-config proxy.conf.json",
    "bff": "node server/index.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/router": "^20.3.25",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.28",
    "@angular/cli": "^20.3.28",
    "@angular/compiler-cli": "^20.3.25",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "typescript": "~5.9.3"
  }
}
